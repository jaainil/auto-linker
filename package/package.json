{
  "name": "@imjp/auto-linker",
  "version": "0.1.0",
  "description": "Deterministic, source-preserving internal links for HTML articles",
  "type": "module",
  "license": "MIT",
  "author": "jaainil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaainil/auto-linker.git",
    "directory": "package"
  },
  "homepage": "https://github.com/jaainil/auto-linker#readme",
  "bugs": {
    "url": "https://github.com/jaainil/auto-linker/issues"
  },
  "keywords": [
    "auto-linker",
    "internal-links",
    "seo",
    "html",
    "content-graph",
    "cross-linking"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run typecheck && npm test && npm run build",
    "evaluate": "npm run build && node evaluation/evaluate.mjs",
    "benchmark": "npm run build && node evaluation/benchmark.mjs",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release:dry-run": "node scripts/release.mjs --dry-run"
  },
  "dependencies": {
    "parse5": "^7.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}

---
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg
  class="brand__mark"
  width={size}
  height={size}
  viewBox="0 0 26 26"
  fill="none"
  aria-hidden="true"
>
  <ellipse
    cx="13"
    cy="13"
    rx="11.2"
    ry="5.1"
    transform="rotate(-34 13 13)"
    stroke="currentColor"
    stroke-width="1"
    stroke-dasharray="1 3"
    opacity="0.5"
  />
  <ellipse
    cx="13"
    cy="13"
    rx="11.2"
    ry="5.1"
    transform="rotate(36 13 13)"
    stroke="currentColor"
    stroke-width="1"
    stroke-dasharray="1 3"
    opacity="0.24"
  />
  <circle cx="13" cy="13" r="2.7" fill="#2563EB" />
  <circle cx="21.7" cy="7.2" r="1.7" fill="currentColor" />
  <circle cx="4.6" cy="18.7" r="1.6" stroke="currentColor" fill="#FFFFFF" />
</svg>

---
import BrandMark from './BrandMark.astro';
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="brand" href="#top" aria-label="JUHENZA Auto-Linker, back to top">
          <BrandMark />
          <span class="brand__word">JUHENZA</span>
          <span class="brand__sub">Auto-Linker</span>
        </a>
        <p>Internal linking that can prove itself. Specified in the open, tested before it ships.</p>
      </div>

      <div class="footer__col">
        <h4>Sections</h4>
        <ul>
          <li><a href="#mechanism">How it works</a></li>
          <li><a href="#demo">Live demo</a></li>
          <li><a href="#api">API</a></li>
          <li><a href="#scoring">Scoring</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4>Blueprint</h4>
        <ul>
          <li><a href="#guarantees">Invariants</a></li>
          <li><a href="#blueprint">Scope and plan</a></li>
          <li><a href="#done">Definition of done</a></li>
          <li><a href="#top">Back to top</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span class="mono">© 2026 JUHENZA</span>
      <span class="mono">MIT proposed</span>
      <span class="mono">TypeScript · Node 22+</span>
